{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APEX Pump Station Manager",
  "mainBinaryName": "apex-pump-station",
  "version": "0.0.0",
  "identifier": "com.apexpump.station.desktop",
  "build": {
    "frontendDist": "dist-web",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "APEX Pump Station Manager",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "visible": false,
        "center": true,
        "decorations": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "APEX Pump Station Manager",
    "category": "Business",
    "shortDescription": "APEX Pump Station Manager — سیستم مدیریت پمپ استیشن",
    "longDescription": "APEX Pump Station Manager — سیستم مدیریت پمپ استیشن (ذخایر، میتر، فروش و خرید تیل، حسابداری)، نسخهٔ دسکتاپ، کاملاً آفلاین.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
